#!/bin/sh
### BEGIN INIT INFO
# Provides:          ft_shield
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ft_shield daemon
### END INIT INFO

DAEMON=/bin/ft_shield
PIDFILE=/var/run/ft_shield.pid

case "$1" in
  start)
    [ -x "$DAEMON" ] || exit 5
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      exit 0
    fi
    "$DAEMON" >/dev/null 2>&1
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")" 2>/dev/null
      rm -f "$PIDFILE"
    fi
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      exit 0
    fi
    exit 3
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    exit 2
    ;;
esac

exit 0

